# SonaWell Midlife Quiz — environment variables
#
# Copy to `.env.local` for local dev (already gitignored).
# Set these on Vercel via: Project → Settings → Environment Variables.
#
# Without any of these set, the app still runs and the quiz works end-to-end;
# the /api/submit handler will skip the Resend capture and log instead.

# ───────────────────────────────────────────────────────────
# Resend (resend.com) — lead capture + result email
# ───────────────────────────────────────────────────────────

# API key. Create at: https://resend.com/api-keys
RESEND_API_KEY=

# Audience quiz leads are added to (fallback for all result types).
# Create at: https://resend.com/audiences — the id is in the audience URL.
RESEND_AUDIENCE_ID=

# Verified sender for the result email, e.g. "Sonali <sonali@sonaliwellness.com>".
# The domain must be verified in Resend (Domains → Add Domain → DNS records).
# If unset, contacts are still captured but no result email is sent.
RESEND_FROM=

# Optional: one audience per result type, for targeting broadcasts/sequences
# at a single cohort (Resend has no tags). When set, the lead joins that
# audience instead of RESEND_AUDIENCE_ID.
RESEND_AUDIENCE_NOT_MYSELF=
RESEND_AUDIENCE_ALWAYS_TIRED=
RESEND_AUDIENCE_OVERWEIGHT_AND_BLOATED=
RESEND_AUDIENCE_DONT_KNOW=

# Optional: base URL used in the result email link.
# Defaults to https://quiz.sonaliwellness.com
SITE_URL=

# ───────────────────────────────────────────────────────────
# Failed-lead fallback — durable capture when Resend fails
# ───────────────────────────────────────────────────────────
#
# Slack or Discord incoming webhook. When set, a failed Resend capture is
# posted here with the lead's name + email + archetype, so the lead can be
# recovered manually. Without it, failed leads are still visible in Vercel
# function logs (still better than a silent failure).

FAILED_LEAD_WEBHOOK_URL=

# Webhook payload format: "slack" (default) or "discord".
# Slack expects { text: ... }; Discord expects { content: ... }.
FAILED_LEAD_WEBHOOK_KIND=
